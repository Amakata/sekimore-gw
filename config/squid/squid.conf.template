# Squid Proxy Configuration for AI Security Gateway
# Generated by Sekimore orchestrator

# Access Control Lists (ACLs)
acl SSL_ports port 443
acl Safe_ports port 80          # http
acl Safe_ports port 443         # https
acl Safe_ports port 53          # dns
acl CONNECT method CONNECT

# Allowed domains (dynamically generated)
{ALLOWED_DOMAINS_ACL}

# Domains another component owns (dynamically generated; empty when the relay is not in use)
{RELAYED_DOMAINS_ACL}

# Deny requests to non-safe ports
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports

# Allow localhost
http_access allow localhost manager
http_access deny manager

# #178: Squid resolves the name itself, so a destination the DNS path refused is still
# reachable here. Refuse by address, before the allowlist is consulted: an allowed name is
# not an allowed destination. Above #205's allow too: on the proxy path the relay hands the
# name over without resolving it, so this rule is the only thing that sees the address.
{DENIED_DESTINATIONS_ACL}
{DENIED_DESTINATIONS_RULE}

# #205: the relay itself, when an upstream proxy is configured. Above the relayed-domain deny
# below, because what the relay asks for is exactly those domains (dynamically generated;
# empty when there is no upstream proxy)
{RELAY_LOCALHOST_ACL}
{RELAY_LOCALHOST_RULE}

# Refuse the relayed domains before the allowlist is consulted
{RELAYED_DOMAINS_RULE}

# Allow whitelisted domains
http_access allow allowed_domains

# Deny all other access
http_access deny all

# Listening port. Unqualified, so Squid listens on every interface including 127.0.0.1, which
# is where the relay sends its CONNECT on the via-Squid route (#205). Nothing in dev can reach
# the gateway's loopback: the INPUT policy is DROP with explicit accepts on lan_if only.
http_port {PROXY_PORT}

# Cache settings
{CACHE_CONFIG}

# Upstream proxy (for a corporate proxy)
{UPSTREAM_PROXY_CONFIG}

# Logging
access_log /var/log/squid/access.log squid
cache_log /var/log/squid/cache.log

# DNS settings
dns_nameservers {DNS_NAMESERVERS}

# Misc
coredump_dir /var/spool/squid
refresh_pattern ^ftp:           1440    20%     10080
refresh_pattern ^gopher:        1440    0%      1440
refresh_pattern -i (/cgi-bin/|\?) 0     0%      0
refresh_pattern .               0       20%     4320
