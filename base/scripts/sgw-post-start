#!/bin/sh
# sgw-post-start — what the dev container runs at every start (devcontainer.json's
# postStartCommand, one line). Five steps, in this order:
#   0. the named volumes handed to this user, when they belong to another uid (#339)
#   1. sudo -E sgw-agent setup     DNS and the route to the gateway, the proxy environment, the
#                                  keys, the project token, known_hosts, ~/.ssh/config, git's
#                                  signing settings, the agent guide, the credential helper taken
#                                  out. -E hands every SEKIMORE_* variable of .env through sudo
#   2. the skills staged in /etc/skel/.claude/skills/ copied into ~/.claude/skills/ (#407)
#   3. docker-init.sh              the inner Docker daemon
#   4. .devcontainer/scripts/post-create.sh of the project, when it has one
# The SGW_* variables below exist for the tests (base/tests/test_sgw_post_start.sh).
set -e
ws=${SGW_WORKSPACE:-/workspace}
# #339: on a Linux host, Dev Containers' updateRemoteUserUID gives this user the host's uid (501,
# say). The named volumes keep the uid they were first written with — 1000 — and so do the image's
# own directories, which updateRemoteUserUID does not touch beyond the home folder. Each one is
# handed over only when its top belongs to someone else, so a start where nothing changed costs a
# stat per directory and nothing more. On Docker Desktop the uid stays 1000 and this does nothing.
uid=${SGW_UID:-$(id -u)}
gid=${SGW_GID:-$(id -g)}
for d in ${SGW_OWNED_DIRS:-"$HOME/.claude" "$HOME/.local/share/mise" "$HOME/.local/share/mise/installs" /commandhistory /pnpm-store /usr/local/share}; do
  [ -e "$d" ] || continue
  [ "$(stat -c %u "$d")" = "$uid" ] && continue
  echo "[sgw-post-start] $d belongs to uid $(stat -c %u "$d"), handing it to $uid:$gid"
  ${SGW_CHOWN:-sudo chown} -R "$uid:$gid" "$d"
done
sudo -E "${SGW_AGENT_BIN:-/usr/local/bin/sgw-agent}" setup
# #407: sgw-install-ai stages the Anthropic skills in /etc/skel, which only a new user gets, and
# Claude Code reads skills only from ~/.claude/skills/. Each staged skill replaces the one of its
# name, so it follows the image; skills of other names are left alone. A skill that cannot be
# copied is reported and the start goes on: the Docker daemon and post-create matter more.
skel=${SGW_SKEL_SKILLS:-/etc/skel/.claude/skills}
for s in "$skel"/*/; do
  [ -d "$s" ] || continue
  name=$(basename "$s")
  { mkdir -p "$HOME/.claude/skills" && rm -rf "$HOME/.claude/skills/$name" &&
    cp -R "$skel/$name" "$HOME/.claude/skills/$name"; } ||
    echo "[sgw-post-start] could not copy the skill $name into $HOME/.claude/skills" >&2
done
"${SGW_DOCKER_INIT:-/usr/local/bin/docker-init.sh}"
post_create=${SGW_POST_CREATE:-$ws/.devcontainer/scripts/post-create.sh}
if [ -f "$post_create" ]; then
  sh "$post_create"
fi
