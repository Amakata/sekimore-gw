#!/bin/sh
# sekimore — agent-side CLI for the sekimore-relay (git / GitHub API gateway).
#
# Loads the project token and endpoint that sekimore-agent-setup.sh wrote to
# /etc/sekimore-agent/env, then runs `sekimore-relay agent "$@"`. Works from any
# process, not only interactive shells (Claude Code tool calls, `docker exec`, scripts).
#
# The env file wins over variables already in the environment: shells started before a
# token refresh still carry the old SEKIMORE_TOKEN, and the file is the source of truth.
# Set SEKIMORE_ENV_OVERRIDE=1 to use the environment as-is (manual testing).
#
# Token refresh: project tokens have a TTL (relay.token_ttl, default 12h). When the
# token in the env file is expired (SEKIMORE_TOKEN_EXPIRES) or the relay rejects it,
# the wrapper re-runs bootstrap — `POST $SEKIMORE_ENDPOINT/bootstrap` with the disposable
# key (SEKIMORE_AGENT_KEY), the same call agent-setup.sh makes — rewrites the env file
# in place (owned by the agent user, 0600), then retries once. The gateway revokes the
# previous token of the same key, so there is one live token per key.
#
#   sekimore whoami
#   sekimore pr create --head sekimore/main-abc1234 --base main --title T
#   sekimore issue create --title T [--labels a,b]
ENV_FILE=${SEKIMORE_AGENT_ENV_FILE:-/etc/sekimore-agent/env}
# Absolute by default so the wrapper does not depend on PATH. The override is for
# tests/test_wrapper_refresh.sh, which drives the wrapper against a fake relay.
BIN=${SEKIMORE_RELAY_BIN:-/usr/local/bin/sekimore-relay}

load_env() {
  if [ "${SEKIMORE_ENV_OVERRIDE:-0}" != "1" ] && [ -r "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
}

# 期限が env にあり過去なら 0
token_expired() {
  [ -n "${SEKIMORE_TOKEN_EXPIRES:-}" ] || return 1
  # `date -u -d <RFC3339>` is GNU coreutils only. This image is Debian, so it is there;
  # on a busybox/BSD date the parse fails, token_expired returns 1, and the refresh
  # falls back to the after-the-failure trigger below. That is the intended degradation.
  exp=$(date -u -d "$SEKIMORE_TOKEN_EXPIRES" +%s 2>/dev/null) || return 1
  now=$(date -u +%s)
  [ "$now" -ge "$exp" ]
}

# bootstrap をやり直して env ファイルを書き換える。成功なら 0
refresh_token() {
  key=${SEKIMORE_AGENT_KEY:-$HOME/.ssh/sekimore/id_ed25519.pub}
  # Each reason is named. A silent `return 1` here is how this bug hid for so long: the
  # caller falls through and the agent sees only the relay's "token expired" again.
  if [ ! -r "$key" ]; then
    echo "sekimore: cannot read the disposable key $key; cannot refresh the token" >&2
    return 1
  fi
  if [ -z "${SEKIMORE_ENDPOINT:-}" ]; then
    echo "sekimore: SEKIMORE_ENDPOINT is not set in $ENV_FILE; cannot refresh the token" >&2
    return 1
  fi
  if [ ! -w "$ENV_FILE" ]; then
    echo "sekimore: $ENV_FILE is not writable by $(id -un); cannot refresh the token" >&2
    return 1
  fi

  # The public key's own line goes into the JSON body verbatim. An ssh public key is
  # `<type> <base64> <comment>` — nothing a JSON string would need escaped — so instead
  # of writing an escaper for a case that cannot occur, refuse the file when it does.
  pub=""
  IFS= read -r pub < "$key" 2>/dev/null
  [ -n "$pub" ] || { echo "sekimore: $key is empty; cannot refresh the token" >&2; return 1; }
  case $pub in
    *'"'* | *\\*)
      echo "sekimore: $key holds a quote or a backslash, so it is not an ssh public key line; cannot refresh the token" >&2
      return 1
      ;;
  esac
  # The label is only a display name on the gateway; keep it to characters that need no
  # escaping either, for the same reason.
  label=$(hostname 2>/dev/null | tr -cd 'A-Za-z0-9._-')

  # /bootstrap is what issues a token, so it carries no Authorization header — which is
  # the point: the token we have is the expired one. This is agent-setup.sh's call.
  # (`sekimore-relay agent bootstrap` does not exist — no relay ever had it.)
  # 2>&1 so a failure carries curl's own reason instead of vanishing; -s keeps stderr
  # empty on success, so $resp is still just the JSON body then.
  if ! resp=$(curl -fsS -m 5 -X POST -H 'Content-Type: application/json' \
                -d "{\"public_key\":\"$pub\",\"label\":\"$label\"}" \
                "$SEKIMORE_ENDPOINT/bootstrap" 2>&1); then
    echo "sekimore: POST $SEKIMORE_ENDPOINT/bootstrap failed, so the token was not refreshed: $resp" >&2
    return 1
  fi
  new=$(printf '%s' "$resp" | grep -o 'skm_[0-9a-f]\{64\}' | head -1)
  if [ -z "$new" ]; then
    # The body is not echoed: it is the one place a token could appear in a log.
    echo "sekimore: $SEKIMORE_ENDPOINT/bootstrap answered without a token; the key may no longer be registered" >&2
    return 1
  fi
  exp=$(printf '%s' "$resp" | grep -o '"token_expires":"[^"]*"' | cut -d'"' -f4)

  # Written in place, not through a temp file next to it: /etc/sekimore-agent is root's
  # and the env file is the agent user's, so `> $ENV_FILE.tmp.$$` is permission denied.
  # Build the whole file in memory first so the redirect that truncates it is the last
  # thing that can fail.
  rest=$(grep -v '^SEKIMORE_TOKEN=\|^SEKIMORE_TOKEN_EXPIRES=' "$ENV_FILE")
  # grep exits 1 when every line was a token line — that is not an error. Anything above
  # 1 is, and writing then would drop SEKIMORE_ENDPOINT and the rest of the file.
  case $? in
    0 | 1) ;;
    *)
      echo "sekimore: could not read $ENV_FILE; leaving it alone" >&2
      return 1
      ;;
  esac
  body="SEKIMORE_TOKEN=$new"
  if [ -n "$exp" ]; then
    body="$body
SEKIMORE_TOKEN_EXPIRES=$exp"
  fi
  if [ -n "$rest" ]; then
    body="$rest
$body"
  fi
  printf '%s\n' "$body" > "$ENV_FILE" || {
    echo "sekimore: could not write the new token to $ENV_FILE" >&2
    return 1
  }
  chmod 600 "$ENV_FILE" 2>/dev/null || true

  echo "sekimore: project token was expired; obtained a new one (expires $exp)" >&2
  load_env
}

load_env
if token_expired && refresh_token; then :; fi

# 実行。トークン起因で失敗したら 1 回だけ更新して再実行する (期限が env に無い古い環境向け)
"$BIN" agent "$@"
rc=$?
if [ "$rc" -ne 0 ] && [ "${1:-}" != "bootstrap" ]; then
  if "$BIN" agent whoami 2>&1 | grep -q 'token expired\|unknown token\|token revoked'; then
    if refresh_token; then
      exec "$BIN" agent "$@"
    fi
  fi
fi
exit "$rc"
