TZ=Asia/Tokyo

# Use the @users.noreply.github.com address from https://github.com/settings/emails.
GIT_AUTHOR_NAME=Name
GIT_AUTHOR_EMAIL=xxx+xxx@users.noreply.github.com
GIT_COMMITTER_NAME=Name
GIT_COMMITTER_EMAIL=xxx+xxx@users.noreply.github.com

# Replace with a name of this project's own. Volumes are keyed by it.
DEVCONTAINER_ID=sgw-sample

# sekimore-relay (docker-compose.relay.yml): the operator's ssh-agent socket, which sekimore-gw
# uses to authenticate to upstream git.
#   Docker Desktop (Mac): the default /run/host-services/ssh-auth.sock is right (Docker Desktop
#                         forwards the host's agent there)
#   Linux host / VM:      name the DIRECTORY the Mac's agent is forwarded into (RemoteForward
#                         /home/<user>/.sekimore/agent.sock; docs/remote-ssh.md). The gateway reads
#                         agent.sock inside it by name, so a socket sshd recreates needs no sgw recreate:
#                         -> SEKIMORE_AGENT_SOCK=/home/<user>/.sekimore
SEKIMORE_AGENT_SOCK=/run/host-services/ssh-auth.sock
# Whether registering the disposable key and issuing the project token happens by itself:
# auto | manual
SEKIMORE_BOOTSTRAP=auto

# Do not stop post-create with an ERROR when the operator's ssh-agent is forwarded into dev
# (discouraged; set it to 1 only while tracking down a cause)
# SEKIMORE_ALLOW_AGENT_FORWARD=1

# The comment on the AI's signing key (the Title it gets on GitHub).
# Default: "sekimore-agent-signing: <SEKIMORE_PROJECT> / <git user.name> <user.email>"
# SEKIMORE_PROJECT=sgw-sample
# SEKIMORE_SIGNING_KEY_COMMENT=sekimore-agent-signing: sgw-sample / Your Name <you@example.com>
